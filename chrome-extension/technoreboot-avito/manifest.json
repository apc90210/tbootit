{
  "manifest_version": 3,
  "name": "Техноребут Avito Мост",
  "version": "0.2.35",
  "description": "Локальная интеграция объявлений Avito с системой учета Техноребут",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Техноребут Avito",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.avito.ru/*",
        "https://avito.ru/*",
        "http://avito.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.avito.ru/*",
    "https://avito.ru/*",
    "http://avito.ru/*",
    "http://localhost:8011/*",
    "http://127.0.0.1:8011/*"
  ]
}
