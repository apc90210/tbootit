# ==============================================================================
# ТехноРебут — Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env before starting the production stack:
#    cp env.production.example .env
# 2. Fill in all required fields marked with [REQUIRED].
# 3. Ensure this file (.env) is never committed to Git and has permissions 0600.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hostname & Domain Configuration [REQUIRED]
# ------------------------------------------------------------------------------
# Public domain or FQDN assigned to this Debian server (e.g. crm.technoreboot.ru).
# Must NOT be localhost or 127.0.0.1 in production.
TECHNOREBOOT_HOSTNAME=

# Public Ports published by Gateway on the host
# Standard: 80 for HTTP redirect, 443 for HTTPS/mTLS
HTTP_PORT=80
HTTPS_PORT=443

# Optional: Container name prefix (defaults to 'technoreboot-prod')
CONTAINER_NAME_PREFIX=technoreboot-prod

# ------------------------------------------------------------------------------
# 2. Data Persistence Root [REQUIRED]
# ------------------------------------------------------------------------------
# Absolute path on the Debian host where all persistent mutable data is stored.
# Must have permissions 0750 owned by the deploy user (e.g. root:docker or technoreboot:technoreboot).
# Subdirectories (db, storage, auth, avito-module, backups) will reside here.
TECHNOREBOOT_DATA_ROOT=/srv/technoreboot/data

# ------------------------------------------------------------------------------
# 3. TLS / mTLS Certificates Configuration [REQUIRED]
# ------------------------------------------------------------------------------
# Absolute path to the public HTTPS server certificate (e.g. from Let's Encrypt or custom CA).
SERVER_TLS_CERT_PATH=/srv/technoreboot/certs/server.crt

# Absolute path to the private key for the server certificate.
# Must have permissions 0600 (not world-readable).
SERVER_TLS_KEY_PATH=/srv/technoreboot/certs/server.key

# Absolute path to the Client CA certificate used by Gateway to authenticate client mTLS certs.
# By default, this is the Technoreboot Root CA generated/restored in auth/ca/ca.crt.
CLIENT_CA_CERT_PATH=/srv/technoreboot/data/auth/ca/ca.crt

# ------------------------------------------------------------------------------
# 4. Security Tokens & Secrets [REQUIRED]
# ------------------------------------------------------------------------------
# Application runtime environment: must be 'production'
APP_ENV=production

# Core API secret token for internal inter-service communication.
# Generate with: openssl rand -hex 32
# Insecure defaults ('dev-token', 'change-me', 'admin', 'password') will trigger startup failure.
CORE_API_TOKEN=

# Session encryption secret key for the inventory cart session cookie.
# Generate with: openssl rand -hex 32
# Insecure defaults ('technoreboot_secret_cart_key_mvp', 'dev-token', etc.) will trigger startup failure.
CART_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 5. Optional Integrations (Avito Official API)
# ------------------------------------------------------------------------------
# Leave blank if not using official Avito API integration.
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=
