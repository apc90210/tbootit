events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # WebSocket upgrade mapping for noVNC
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Plain HTTP permanent redirect to HTTPS
    server {
        listen 80;
        server_name ${TECHNOREBOOT_HOSTNAME};

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # Public HTTPS Gateway protected by client mTLS
    server {
        listen 443 ssl;
        server_name ${TECHNOREBOOT_HOSTNAME};

        # Server TLS Certificate & Private Key
        ssl_certificate     /etc/nginx/certs/server/server.crt;
        ssl_certificate_key /etc/nginx/certs/server/server.key;

        # Client CA Certificate for mutual TLS verification
        ssl_client_certificate /etc/nginx/certs/ca/ca.crt;
        ssl_verify_client optional;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        client_max_body_size 50M;

        # Internal mTLS authentication verification subrequest
        location = /internal-auth/verify {
            internal;
            proxy_pass http://admin-shell:8010/internal-auth/verify;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Client-Cert-Serial $ssl_client_serial;
            proxy_set_header X-Client-Cert-Fingerprint $ssl_client_fingerprint;
            proxy_set_header X-Client-Cert-Verify $ssl_client_verify;
        }

        # Main application proxy protected by mTLS subrequest
        location / {
            auth_request /internal-auth/verify;
            auth_request_set $auth_subject $upstream_http_x_auth_subject;
            auth_request_set $auth_is_owner $upstream_http_x_auth_is_owner;

            proxy_pass http://admin-shell:8010;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port $server_port;

            # Forward verified client identity headers from gateway to admin-shell
            proxy_set_header X-Client-Cert-Serial $ssl_client_serial;
            proxy_set_header X-Client-Cert-Fingerprint $ssl_client_fingerprint;
            proxy_set_header X-Client-Cert-Verify $ssl_client_verify;
            proxy_set_header X-Auth-Subject $auth_subject;
            proxy_set_header X-Auth-Is-Owner $auth_is_owner;
        }
    }
}
